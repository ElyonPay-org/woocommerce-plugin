# Build / VCS tooling — jamais dans le zip distribué
/.git
/.github
/.gitignore
/.distignore
/.claude
/node_modules
/tests

# Assets de la fiche WordPress.org (gérés séparément, pas dans le plugin)
/.wordpress-org

# Composer : on garde vendor/ et composer.json (Plugin Check le demande quand vendor/ est livré), pas le lock
composer.lock

# Doc développeur (WordPress.org utilise readme.txt, pas README.md)
/README.md

# Divers
.DS_Store
*.dist
*.log
